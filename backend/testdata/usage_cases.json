      { "seq": 7, "ts": 6000, "type": "session.usage", "actor": "m1", "task": "T1", "attempt": 1, "data": { "totalTokens": 1000 } },
      { "seq": 8, "ts": 7000, "type": "session.usage", "actor": "m1", "task": "T1", "attempt": 1, "data": { "totalTokens": 2500 } },
